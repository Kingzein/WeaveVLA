{
  "version": "weavevla_metric_geometry",
  "depth": {
    "model": "depth-anything/DA3METRIC-LARGE",
    "precision": "bf16",
    "process_res": 518,
    "process_res_method": "upper_bound_resize",
    "output": "fp32_axial_metres",
    "metric_conversion": "official_apply_metric_scaling_once"
  },
  "geometry": {
    "stride": 8,
    "mask_iou": 0.85,
    "centroid_px_224": 1.5,
    "area_change": 0.15,
    "rgb_mad": 8.0,
    "erosion_px_224": 2,
    "core_pixels_224": 20,
    "confirmations": 2,
    "min_anchors": 2,
    "scale_min": 0.8,
    "scale_max": 1.25,
    "scale_fallback": "retain_short_then_reset",
    "scale_ttl_steps": 16,
    "near_gripper_m": 0.05,
    "occlusion_ttl_steps": 64,
    "min_points": 16,
    "surface_points": 128,
    "distance_definition": "object_centroid_to_kinematic_tcp_euclidean",
    "gripper_mask_scope": "two_finger_subtrees_only",
    "hold_clearance": "centroid_distance_minus_bounding_radii_gt_near_gripper_m",
    "gripper_position": "kinematic_grip_site_camera_no_depth_scale"
  },
  "graph": {
    "hidden_dim": 256,
    "num_heads": 8,
    "num_queries": 16,
    "pre_layers": 2,
    "task_layers": 2,
    "qformer_layers": 2,
    "max_objects": 64,
    "max_points": 512,
    "use_visual_patches": true,
    "geometry_input_dim": 4,
    "geometry_loss_dim": 4,
    "edge_status_input": false,
    "node_gate": false,
    "edge_memory_position": "after_pre_before_qwen",
    "edge_fusion": "concat_mlp",
    "edge_memory_ttl_steps": 64,
    "surface_points": 128,
    "bptt": 1,
    "prompt_local_k": 2,
    "gripper_position": "tcp"
  }
}
